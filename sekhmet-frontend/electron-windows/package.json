{
  "name": "sekhmet-shop-admin-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-serve": "^1.3.0"
  },
  "build": {
    "appId": "com.sekhmetshop.admin",
    "productName": "Sekhmet Shop Admin",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "dist/**/*",
      "icon.ico",
      "node_modules/**/*"
    ]
  }
}
