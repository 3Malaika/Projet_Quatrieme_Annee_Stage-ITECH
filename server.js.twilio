import "dotenv/config";
import express from "express";
import twilio from "twilio";
import Groq from "groq-sdk";

// Initialisation des clients
const app = express();
app.use(express.urlencoded({ extended: false }));

const groq = new Groq({
  apiKey: process.env.GROQ_API_KEY,
});

const{ MessagingResponse } = twilio.twiml;

//Memoire de la conversation
// on va utiliser un objet pour stocker les conversations en mémoire. Chaque conversation sera identifiée par le numéro de téléphone de l'utilisateur.
const conversations = {};

function getHistory(phoneNumber) {
  if (!conversations[phoneNumber]) {
    conversations[phoneNumber] = [
        {
            role: "system",
            content: "Tu es le service client de seknet, reponds de facon polie."
        },
    ];
  }
  return conversations[phoneNumber];
}

// appell a l'ia

async function askGroq(phoneNumber, userMessage) {
    const history = getHistory(phoneNumber);
    history.push({ role: "user", content: userMessage });
    const response = await groq.chat.completions.create({
        model: "llama3-3.3-70b-versatile ",
        max_tokens: 500,
        messages: history
    });
    const reply = response.choices[0].message.content;
    history.push({ role: "assistant", content: reply });

    return response.choices[0].message;
}

// Route pour recevoir les messages Twilio
app.post("/webhook", async (req, res) => {
  const userMessage = req.body.Body;
  const from = req.body.From;

  console.log(`Message reçu de ${from}: ${userMessage}`);

  try {
    const reply = await askGroq(from, userMessage);
    twilml = new MessagingResponse();
  } catch (err) {
    console.error("Erreur lors de l'appel à Groq:", err);
    twilml = new MessagingResponse();
    twilml.message("Désolé, une erreur est survenue. Veuillez réessayer plus tard.");
  }
  res.type("text/xml");send(twilml.toString());
});


// Démarrage du serveur
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`Serveur démarré sur le port ${PORT}`);
});