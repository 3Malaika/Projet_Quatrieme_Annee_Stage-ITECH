PORT=3000
ADMIN_TOKEN=change-moi

# Local : SQLite. Sur Render/production : mettre STORAGE_MODE=supabase.
# Si STORAGE_MODE est absent et que SUPABASE_URL + SUPABASE_SERVICE_KEY sont présents,
# le backend choisit automatiquement Supabase pour éviter un stockage éphémère.
STORAGE_MODE=sqlite
DATA_DIR=./data
SQLITE_DB_PATH=./data/sekhmet.sqlite
UPLOAD_DIR=./uploads/produits
PUBLIC_BASE_URL=http://localhost:3000

# Services externes optionnels selon les fonctions activées.
GROQ_API_KEY=
VERIFY_TOKEN=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Les agents humains (numéro, priorité, plage horaire) se gèrent désormais
# uniquement depuis l'admin : Configuration -> Escalades. Cette variable
# n'est plus utilisée par le code.
# HUMAN_AGENT_NUMBER=

# Production Render :
# STORAGE_MODE=supabase
# SUPABASE_URL=...
# SUPABASE_SERVICE_KEY=...

# Factures
BUSINESS_NAME=Sekhmet Shop
BUSINESS_CONTACT=WhatsApp : +237 620 70 97 32
BUSINESS_ADDRESS=
BUSINESS_CURRENCY=FCFA
INVOICE_LOGO_PATH=./assets/logo.png
# Template WhatsApp approuvé par Meta pour relancer une escalade lorsque le
# destinataire n'a pas de fenêtre 24 h ouverte (erreur Meta 131047).
# Le template doit avoir 2 variables BODY : {{1}} = numéro client, {{2}} = sujet.
WHATSAPP_ESCALATION_TEMPLATE_NAME=
WHATSAPP_ESCALATION_TEMPLATE_LANGUAGE=fr
